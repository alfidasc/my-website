/* شريط التقدّم (احتياطي) + الهيدر + زر الأعلى */
const hdr=$('header'),pr=$('#pr'),up=$('#up'),nat=CSS.supports('animation-timeline','scroll()');
addEventListener('scroll',()=>{const y=scrollY;hdr.classList.toggle('s',y>30);up.classList.toggle('v',y>700);if(!nat){const m=document.documentElement.scrollHeight-innerHeight;pr.style.transform=`scaleX(${m>0?y/m:0})`}},{passive:true});up.onclick=()=>scrollTo({top:0});
/* عدّاد الإطارات */
const fp=$('#fps');let fo=false,fl=0,fn=0;const ft=t=>{fn++;if(t-fl>=500){fp.textContent=Math.round(fn*1000/(t-fl))+' FPS';fn=0;fl=t}fo&&raf(ft)};
function fpsToggle(){fo=!fo;fp.hidden=!fo;if(fo){fl=performance.now();fn=0;raf(ft)}}
/* لوحة البحث والأوامر */
const dl=$('#cp'),qi=$('#q'),ql=$('#ql');let it=[],sel=0;
const ACT=[['الرئيسية','صفحة','#home'],['عن الاتحاد','صفحة','#about'],['الأندية','صفحة','#clubs'],['البطولات','صفحة','#tournaments'],['سجل البطولات','صفحة','#history'],['الأخبار والإعلانات','صفحة','#news'],...C.map(c=>[c.n,'نادٍ','#club-'+c.id])].map(a=>({t:a[0],s:a[1],run:()=>location.hash=a[2]})).concat([{t:'تبديل الوضع الليلي/النهاري',s:'أمر',run:flip},{t:'عداد الإطارات FPS',s:'أمر',run:fpsToggle},{t:'مشاركة الموقع',s:'أمر',run:share}]);
function share(){const d={title:document.title,url:location.href};navigator.share?navigator.share(d).catch(()=>{}):navigator.clipboard&&navigator.clipboard.writeText(d.url)}
function lst(){const v=qi.value.trim();it=ACT.filter(a=>!v||a.t.includes(v));sel=Math.min(sel,Math.max(it.length-1,0));ql.innerHTML=it.map((a,i)=>`<li role="option" data-i="${i}" aria-selected="${i==sel}">${a.t}<small>${a.s}</small></li>`).join('')||'<li class="mut">لا توجد نتائج</li>'}
function open(){qi.value='';sel=0;lst();dl.showModal();qi.focus()}
function pick(i){const a=it[i];if(a){dl.close();a.run()}}
qi.oninput=()=>{sel=0;lst()};ql.onclick=e=>{const l=e.target.closest('li[data-i]');l&&pick(+l.dataset.i)};dl.onclick=e=>{if(e.target==dl)dl.close()};
qi.onkeydown=e=>{if(e.key=='ArrowDown'||e.key=='ArrowUp'){e.preventDefault();sel=(sel+(e.key=='ArrowDown'?1:-1)+it.length)%it.length;lst();$('[aria-selected=true]',ql)?.scrollIntoView({block:'nearest'})}else if(e.key=='Enter')pick(sel)};
$('#sr').onclick=open;$('#kb').onclick=open;$('#shr').onclick=share;
addEventListener('keydown',e=>{const k=e.key.toLowerCase(),ty=/INPUT|TEXTAREA/.test(document.activeElement.tagName);if((e.ctrlKey||e.metaKey)&&k=='k'){e.preventDefault();dl.open?dl.close():open()}else if(!ty&&!dl.open&&(k=='/'||k=='f'||k=='ب')){e.preventDefault();k=='/'?open():fpsToggle()}});
</script></body></html>
