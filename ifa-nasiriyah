history:()=>ph('سجل البطولات','أرشيف نسخ دوري أبطال الناصرية. تُضاف النسخ القادمة هنا عند اكتمالها.')+`<div class="w pg"><details open><summary>2025 — البطل: نادي الفداء سيتي</summary><div><p>الأندية المشاركة (4): الفداء سيتي، نادي الصحة (سابقاً التضحية سيتي)، كتلونيا العسكري، نادي الشيعة.</p>${tb()}</div></details></div>`,
news:()=>ph('الأخبار والإعلانات','الأخبار والقرارات الرسمية للاتحاد.')+`<div class="w pg"><div class="chips">${['الكل'].concat(CATS).map(c=>{const v=c=='الكل'?'':c;return `<button type="button" data-c="${v}" aria-pressed="${v==fc}">${c}</button>`}).join('')}</div><div id="nl">${newsList()}</div></div>`};
const TT={about:'عن الاتحاد',clubs:'الأندية',tournaments:'البطولات',history:'سجل البطولات',news:'الأخبار والإعلانات'};
function clubPage(c){const i=T.findIndex(x=>x[0]==c.id),r=T[i];return `<div class="ph" data-club="${c.id}"><div class="w"><nav class="bc" aria-label="مسار التنقل"><a href="#home">الرئيسية</a> / <a href="#clubs">الأندية</a> / ${c.n}</nav><div class="cb">${bd(c,1)}<div><h1>${c.n}</h1>${c.old?`<p>سابقاً: ${c.old}</p>`:''}</div></div></div></div><div class="w pg" data-club="${c.id}"><p>أحد الأندية الأربعة المنتسبة إلى اتحاد الناصرية الرسمي في الفداء، وشارك في دوري أبطال الناصرية 2025.</p><h2>المشاركة في البطولات</h2><div class="cb"><svg class="rg" viewBox="0 0 120 120" role="img" aria-label="${r[3]} نقطة"><circle class="a" cx="60" cy="60" r="50"/><circle class="b" cx="60" cy="60" r="50" pathLength="100" stroke-dashoffset="${100-Math.round(r[3]/T[0][3]*100)}"/><text x="60" y="70">${r[3]}</text></svg><p style="margin:0">دوري أبطال الناصرية 2025 — المركز ${i+1} من 4.</p></div><div class="kv"><div><small>لعب</small><b>${r[2]}</b></div><div><small>النقاط</small><b>${r[3]}</b></div><div><small>الأهداف</small><b class="ltr">${r[4]}</b></div><div><small>الفارق</small><b class="ltr">${r[5]}</b></div></div><h2>الإنجازات</h2>${i==0?'<div class="ch"><b>بطل دوري أبطال الناصرية 2025</b></div>':emp('لا توجد إنجازات مسجلة بعد.')}<p style="margin-top:28px"><a class="bt" href="${c.ig}" target="_blank" rel="noopener noreferrer">حساب النادي على إنستغرام</a></p></div>`}
/* التوجيه مع انتقالات سلسة */
function route(){let h=location.hash.slice(1)||'home',k=h.split('-')[0],o,t='اتحاد الناصرية الرسمي في الفداء';
if(h.startsWith('club-')){const c=cl(h.slice(5));if(c){t=c.n;o=clubPage(c)}}
else if(h.startsWith('news-')){const n=NEWS.find(x=>x.id==h.slice(5));if(n){t=n.title;o=`<div class="w pg" style="max-width:760px"><p><a href="#news" class="mut">← الأخبار</a></p><span class="mut">${n.cat} · ${n.date}</span><h1>${n.title}</h1>${n.img?`<img src="${n.img}" alt="" style="width:100%;height:auto">`:''}${n.body}</div>`}}
else if(P[h]){o=P[h]();if(h!='home')t=TT[h]+' | '+t}
if(!o){o='<div class="w pg"><h1>الصفحة غير موجودة</h1><p><a class="bt" href="#home">العودة للرئيسية</a></p></div>';k=''}
app.innerHTML=o;document.title=t;const m=k=='club'?'clubs':k;$$('#nv a').forEach(a=>a.dataset.r==m?a.setAttribute('aria-current','page'):a.removeAttribute('aria-current'));
$('#nv').classList.remove('o');$('#bg').setAttribute('aria-expanded','false');scrollTo({top:0,behavior:'instant'});rev();fx();orbTilt()}
const go=()=>document.startViewTransition&&!RM.matches?document.startViewTransition(route):route();
addEventListener('hashchange',go);route();
/* ظهور تدريجي وعدّادات */
function cnt(s,n){let t0;const f=t=>{t0=t0||t;const p=Math.min((t-t0)/1200,1);s.textContent=Math.round(n*(1-Math.pow(1-p,4)));p<1&&raf(f)};raf(f)}
function rev(){if(!('IntersectionObserver' in window)||RM.matches)return;const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const t=e.target;io.unobserve(t);t.classList.add('on');if(t.matches('.st>div')){const s=$('strong',t);s.dataset.n&&cnt(s,+s.dataset.n)}setTimeout(()=>{t.classList.remove('rv','on');t.style.transitionDelay=''},1800)}),{threshold:.12,rootMargin:'0px 0px -6% 0px'}),seen=[];
$$('.sh,.g4>*,.g2>*,.kv>*,.st>div,.fb .w>div,tbody tr,details,.ch,.emp,.pod,.pg>h2,.pg>h3,.pg>p,.chips').forEach(x=>{if(seen.includes(x)||x.closest('.rv'))return;seen.push(x);x.style.transitionDelay=Math.min([].indexOf.call(x.parentNode.children,x),8)*80+'ms';x.classList.add('rv');io.observe(x)})}
/* جسيمات الهيرو: تتبّع معدّل تحديث الشاشة (60/90/120/144Hz) عبر dt */
function fx(){const cv=$('#fx');if(!cv||RM.matches)return;const x=cv.getContext('2d'),dpr=Math.min(devicePixelRatio||1,2),hero=cv.parentNode;let w,h,P=[],mx=-1e3,my=-1e3,on=true,lt=0,col='#f5b800';
const rs=()=>{const r=cv.getBoundingClientRect();w=r.width;h=r.height;cv.width=w*dpr;cv.height=h*dpr;x.setTransform(dpr,0,0,dpr,0,0);col=getComputedStyle(cv).getPropertyValue('--pc').trim()||col;P=Array.from({length:Math.round(Math.min(80,w*h/15000))},()=>({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.04,vy:(Math.random()-.5)*.04,r:Math.random()*1.7+.6}))};
rs();new ResizeObserver(rs).observe(cv);
hero.addEventListener('pointermove',e=>{const r=cv.getBoundingClientRect();mx=e.clientX-r.left;my=e.clientY-r.top});hero.addEventListener('pointerleave',()=>mx=my=-1e3);
new IntersectionObserver(e=>{const v=e[0].isIntersecting;if(v&&!on){on=true;lt=0;raf(f)}on=v}).observe(cv);
function f(t){if(!cv.isConnected||!on)return;const dt=Math.min(t-(lt||t),50);lt=t;x.clearRect(0,0,w,h);x.fillStyle=col;x.strokeStyle=col;
for(const p of P){const dx=mx-p.x,dy=my-p.y,d=dx*dx+dy*dy;if(d<22500){const k=(1-d/22500)*.0009*dt;p.vx+=dx*k*.02;p.vy+=dy*k*.02}p.vx*=.995;p.vy*=.995;p.x+=p.vx*dt;p.y+=p.vy*dt;if(p.x<0)p.x=w;if(p.x>w)p.x=0;if(p.y<0)p.y=h;if(p.y>h)p.y=0;x.globalAlpha=.7;x.beginPath();x.arc(p.x,p.y,p.r,0,6.283);x.fill()}
x.lineWidth=.7;for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++){const a=P[i],b=P[j],dx=a.x-b.x,dy=a.y-b.y,d=dx*dx+dy*dy;if(d<12100){x.globalAlpha=(1-d/12100)*.28;x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.stroke()}}raf(f)}
raf(f)}
/* مدار ثلاثي الأبعاد يتبع المؤشر + توهّج الهيرو */
function orbTilt(){const o=$('#orb'),hero=$('.hero'),gl=$('#gl');if(!hero||RM.matches)return;hero.addEventListener('pointermove',e=>{const r=hero.getBoundingClientRect();if(gl)gl.style.transform=`translate3d(${e.clientX-r.left-260}px,${e.clientY-r.top-260}px,0)`;if(o&&e.pointerType=='mouse'){o.style.setProperty('--rx',((e.clientX/innerWidth-.5)*14)+'deg');o.style.setProperty('--ry',((e.clientY/innerHeight-.5)*-14)+'deg')}})}
/* بطاقات: وهج يتبع المؤشر + إمالة (محدودة بإطار الشاشة) */
let pe=null,pf=0;addEventListener('pointermove',e=>{pe=e;pf||(pf=raf(()=>{pf=0;const c=pe.target.closest&&pe.target.closest('.cd');if(!c)return;const b=c.getBoundingClientRect(),px=pe.clientX-b.left,py=pe.clientY-b.top;c.style.setProperty('--px',px+'px');c.style.setProperty('--py',py+'px');if(c.classList.contains('cc')&&pe.pointerType=='mouse'&&!RM.matches)c.style.transform=`perspective(800px) rotateY(${-(px/b.width-.5)*10}deg) rotateX(${(py/b.height-.5)*10}deg) translateY(-6px)`}))},{passive:true});
document.addEventListener('pointerout',e=>{const c=e.target.closest&&e.target.closest('a.cc');if(c&&!c.contains(e.relatedTarget))c.style.transform=''});
app.addEventListener('click',e=>{const b=e.target.closest('[data-c]');if(b){fc=b.dataset.c;$('#nl').innerHTML=newsList();$$('.chips button').forEach(x=>x.setAttribute('aria-pressed',x.dataset.c==fc))}});
$('#bg').onclick=function(){this.setAttribute('aria-expanded',$('#nv').classList.toggle('o'))};$('#sk').onclick=()=>app.focus();
/* الوضع */
const rt=document.documentElement,tc=$('meta[name=theme-color]'),th=$('#th');
function setTheme(t){rt.dataset.theme=t;tc.content=t=='dark'?'#0f0e0a':'#f7f4ec';th.textContent=t=='dark'?'☀':'☾';th.setAttribute('aria-label',t=='dark'?'التبديل إلى الوضع النهاري':'التبديل إلى الوضع الليلي')}
const flip=()=>{const n=rt.dataset.theme=='dark'?'light':'dark';try{localStorage.setItem('theme',n)}catch(e){}document.startViewTransition&&!RM.matches?document.startViewTransition(()=>setTheme(n)):setTheme(n)};
